datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Trade {
  id          Int      @id @default(autoincrement())
  clerkUserId String
  date        String
  entry_time  String
  exit_time   String
  account     String
  instrument  String
  direction   String
  qty         Int
  entry       Float
  exit_price  Float
  gross       Float
  commission  Float
  pnl         Float
  mae         Float
  mfe         Float
  etd         Float
  rr          Float
  result      String
  strategy    String
  timeframe   String
  notes       String
  image       String?
  balance     Float?   // Balance de cierre del día (resumen diario Bulenox)
  threshold   Float?   // Umbral de autoliquidación / DD del día
  createdAt   DateTime @default(now())
}

model Account {
  id               Int      @id @default(autoincrement())
  clerkUserId      String
  name             String
  size             Float    // Current broker balance (updated each weekend via sync)
  startSize        Float?   // Original starting balance, never changes (e.g. 50000, 25000)
  target           Float
  dd_limit         Float
  daily_limit      Float
  status           String   @default("ACTIVE")
  type             String   @default("EXAMEN")
  balance          Float?
  threshold        Float?
  updateDate       String?
  activeDays       Int?
  brokerUpdateTime String?
  planId           String?  // Plan ID de Bulenox (ej. "1MLBQ")
  nextBill         String?  // Próxima facturación MM/DD/YY
  maxContracts     Int?     // Máximo de contratos permitidos
  closedPnl        Float?   // PnL cerrado acumulado (Closed P&L)
  safetyReserve    Float?   // Reserva de seguridad (cuentas REAL)
  bestPnlDay       String?  // Mejor día de PnL (texto, ej. "$417.46 (06/11/26)")
  consistency      String?  // Consistencia (texto, ej. "87%")
  createdAt        DateTime @default(now())

  @@unique([clerkUserId, name])
}

model UserSettings {
  clerkUserId         String   @id
  layout              String?  // Array of module IDs
  visibility          String?  // Map of module visibility states
  theme               String?  // "light" or "dark"
  acctFilter          String?  // e.g., "all" or specific account name
  accountsPanelFilter String?  // e.g., "all", "ACTIVE", etc.
  aiProvider          String?  // "gemini", "openai", etc.
  aiKey               String?  // Encryption is optional/local
  updatedAt           DateTime @updatedAt
}


