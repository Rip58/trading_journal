datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model Trade {
  id          Int      @id @default(autoincrement())
  date        String
  entry_time  String
  exit_time   String
  account     String
  instrument  String
  direction   String
  qty         Int
  entry       Float
  exit_price  Float
  gross       Float
  commission  Float
  pnl         Float
  mae         Float
  mfe         Float
  etd         Float
  rr          Float
  result      String
  strategy    String
  timeframe   String
  notes       String
  image       String?
  createdAt   DateTime @default(now())
}

model Account {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  size        Float
  target      Float
  dd_limit    Float
  daily_limit Float
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}

