// Esquema de Huella Digital.
//
// Nota sobre catálogos: los datasets de sitios y servicios NO viven aquí. Son
// datos de solo lectura que se versionan como JSON en data/ y se actualizan con
// scripts/fetch-catalogs.mjs. La base de datos guarda solo lo que es de cada
// persona: qué se buscó, qué se encontró, y qué solicitudes se han enviado.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Entrada
// ---------------------------------------------------------------------------

/// Lo que la persona rellenó en el cuestionario, tal cual.
model Sujeto {
  id        String   @id @default(cuid())
  creadoEn  DateTime @default(now())

  emails    String[] @default([])
  alias     String[] @default([])
  nombre    String?
  ciudad    String?
  telefono  String?
  dominios  String[] @default([])

  /// Declaración de titularidad. Sin esto no se escanea: es la barrera que
  /// impide que alguien analice a un tercero, y la base legal el día que
  /// esto sea un producto con clientes.
  titularidadAceptada Boolean @default(false)

  /// Permite explícitamente categorías sensibles (NSFW, dating). Por defecto no.
  incluirSensibles Boolean @default(false)

  escaneos Escaneo[]
}

/// Un identificador concreto que se escanea. Es la unidad real de trabajo, y
/// existe separada de Sujeto porque el bucle de pivote descubre identificadores
/// que nadie introdujo y hay que poder decir de dónde salió cada uno.
model Identificador {
  id       String          @id @default(cuid())
  escaneo  Escaneo         @relation(fields: [escaneoId], references: [id], onDelete: Cascade)
  escaneoId String
  tipo     TipoIdentificador
  valor    String
  origen   OrigenIdentificador @default(CUESTIONARIO)

  /// Si vino del pivote, de qué identificador se dedujo. Se muestra en la
  /// interfaz: enseñar datos que la persona nunca introdujo sin decir de dónde
  /// salen resulta inquietante en vez de valioso.
  derivadoDe   Identificador?  @relation("Pivote", fields: [derivadoDeId], references: [id], onDelete: SetNull)
  derivadoDeId String?
  derivados    Identificador[] @relation("Pivote")

  hallazgos Hallazgo[]

  @@unique([escaneoId, tipo, valor])
  @@index([escaneoId])
}

enum TipoIdentificador {
  EMAIL
  ALIAS
  NOMBRE
  TELEFONO
  DOMINIO
}

enum OrigenIdentificador {
  CUESTIONARIO
  PIVOTE
}

// ---------------------------------------------------------------------------
// Escaneo
// ---------------------------------------------------------------------------

model Escaneo {
  id       String   @id @default(cuid())
  /// Identificador público, el que va en la URL. Opaco y no adivinable: en el
  /// nivel gratis no hay login, así que este token es el único control de acceso.
  token    String   @unique
  creadoEn DateTime @default(now())

  sujeto   Sujeto @relation(fields: [sujetoId], references: [id], onDelete: Cascade)
  sujetoId String

  nivel  Nivel        @default(GRATIS)
  estado EstadoEscaneo @default(PENDIENTE)

  /// Progreso por tandas. El cliente pide tandas sucesivas y esto permite
  /// reanudar si se cierra el navegador a mitad.
  sitiosTotal Int @default(0)
  sitiosHechos Int @default(0)

  /// Ronda del bucle de pivote: 0 es la pasada original, 1 la derivada.
  /// Tope de 2 pasadas, o el pivote se ramifica sin control.
  rondaPivote Int @default(0)

  /// Nulo mientras es propiedad de nadie. Se rellena al enchufar Clerk, para
  /// que un escaneo anónimo se pueda reclamar después.
  propietarioId String?

  pagadoEn DateTime?

  /// Cuándo se purgan los datos de filtraciones asociados. Guardar registros de
  /// brechas a perpetuidad convierte esta app en el próximo objetivo.
  expiraEn DateTime?

  identificadores Identificador[]
  hallazgos       Hallazgo[]

  @@index([propietarioId])
  @@index([expiraEn])
}

enum Nivel {
  GRATIS
  PROFUNDO
}

enum EstadoEscaneo {
  PENDIENTE
  EN_CURSO
  COMPLETADO
  FALLIDO
}

// ---------------------------------------------------------------------------
// Resultados
// ---------------------------------------------------------------------------

model Hallazgo {
  id        String   @id @default(cuid())
  creadoEn  DateTime @default(now())

  escaneo   Escaneo @relation(fields: [escaneoId], references: [id], onDelete: Cascade)
  escaneoId String

  identificador   Identificador? @relation(fields: [identificadorId], references: [id], onDelete: SetNull)
  identificadorId String?

  tipo   TipoHallazgo
  fuente String

  /// Nombre legible del sitio o servicio ("GitHub (User)", "Adobe").
  nombre String
  url    String?
  /// Dominio registrable, la clave con la que se cruza con el catálogo de bajas.
  dominio String?

  confianza Confianza
  severidad Severidad @default(BAJA)

  /// Carga útil específica de la fuente. Los datos de filtraciones que caen
  /// aquí son lo que purga expiraEn.
  datos Json?

  solicitudes Solicitud[]

  @@index([escaneoId, confianza])
  @@index([escaneoId, tipo])
}

enum TipoHallazgo {
  CUENTA
  BRECHA
  FILTRACION
  BROKER
  BUSQUEDA
  PERFIL
  DOMINIO
}

/// Tres estados, no dos. Escaneando desde IPs de datacenter bastantes sitios
/// bloquean o responden de forma ambigua, y marcar eso como NO_ENCONTRADO sería
/// mentir. Quien ha pagado merece saber qué no se pudo comprobar.
enum Confianza {
  ENCONTRADO
  NO_ENCONTRADO
  NO_CONCLUYENTE
}

enum Severidad {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

// ---------------------------------------------------------------------------
// Bajas
// ---------------------------------------------------------------------------

model Solicitud {
  id       String   @id @default(cuid())
  creadaEn DateTime @default(now())

  hallazgo   Hallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)
  hallazgoId String

  servicio String
  canal    CanalSolicitud
  base     BaseLegal      @default(ART17)
  estado   EstadoSolicitud @default(PENDIENTE)

  /// Cuándo dice la persona que la envió, y el plazo del art. 12.3 RGPD que
  /// arranca a partir de ahí: un mes para responder.
  enviadaEn DateTime?
  venceEn   DateTime?

  notas String?

  @@index([hallazgoId])
  @@index([estado, venceEn])
}

enum CanalSolicitud {
  FORMULARIO
  EMAIL
  CUENTA
}

enum BaseLegal {
  ART15
  ART17
  ART21
}

enum EstadoSolicitud {
  PENDIENTE
  ENVIADA
  RESPONDIDA
  CUMPLIDA
  DENEGADA
  VENCIDA
}
